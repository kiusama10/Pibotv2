# PiBot / Render environment example
# Never commit real secrets.

# Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
BOT_USERNAME=YourBotUsernameWithoutAt

# PostgreSQL / Supabase connection string used by the current codebase.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Comma-separated Telegram numeric IDs with BotMaster privileges.
# The first ID receives the 20% Kiu share from auctions.
BOTMASTER_IDS=

# Drawing WebApp public HTTPS base URL (normally your Render service URL).
# Example: https://your-service.onrender.com
WEBAPP_BASE_URL=

# Music: leave MUSIC_THREAD_ID blank until the exact topic is confirmed.
# With it blank, PiBot charges NOTHING for music posts.
MUSIC_THREAD_ID=
MUSIC_POST_PRICE=500

# BANKIU defaults; adjust before production if desired.
BANKIU_INTEREST_PERCENT=10
BANKIU_TERM_DAYS=7

# Optional JSON list. Empty means channel purchases are disabled/no charge.
# Example format only (replace with your real catalog):
# PIBOT_CHANNEL_CATALOG=[{"code":"vip","name":"Canal VIP","price":10000,"description":"Acceso configurado por administración"}]
PIBOT_CHANNEL_CATALOG=

LOG_LEVEL=INFO
